{
  "id": "com.myriad.quick-notes",
  "name": "便携便签",
  "version": "1.0.0",
  "minSystemVersion": "0.2.1",
  "description": "简单高效的笔记工具，快速记录想法和灵感",
  "category": "productivity",
  "main": "main.js",
  "author": {
    "name": "Myriad Team",
    "url": "https://github.com/Myriad-You"
  },
  "permissions": [
    "storage",
    "widget:register",
    "ui:notification",
    "ui:theme",
    "ui:confirm"
  ],
  "iconSvg": "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M8 2v3M16 2v3M3 9h18M21 8.5V17c0 3-1.5 5-5 5H8c-3.5 0-5-2-5-5V8.5c0-3 1.5-5 5-5h8c3.5 0 5 2 5 5z' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/><path d='M8 14h4M8 18h8' stroke='currentColor' stroke-width='2' stroke-linecap='round'/></svg>",
  "themeColor": "#FFA726",
  "hasPage": true,
  "cssMode": "separated",
  "widgetStyles": "widget.css",
  "pageStyles": "page.css",
  "pageTemplate": "page.html",
  "widgets": [
    {
      "id": "notes",
      "name": "便签",
      "description": "快速查看和添加笔记",
      "icon": "note",
      "defaultSize": "2x2",
      "sizes": ["2x2", "4x2", "4x4"],
      "refreshPolicy": {
        "mode": "event",
        "refreshOnVisible": true
      },
      "category": "utility",
      "templates": {
        "2x2": "widget-2x2.html",
        "4x2": "widget-4x2.html",
        "4x4": "widget-4x4.html"
      }
    }
  ],
  "settings": [
    {
      "key": "maxNotes",
      "label": "最大笔记数",
      "type": "number",
      "description": "保留的最大笔记数量",
      "defaultValue": 100,
      "min": 10,
      "max": 500
    },
    {
      "key": "showTimestamp",
      "label": "显示时间戳",
      "type": "toggle",
      "description": "在笔记下方显示创建时间",
      "defaultValue": true
    },
    {
      "key": "saveHistory",
      "label": "保存历史",
      "type": "toggle",
      "description": "关闭后清空历史便签",
      "defaultValue": true
    },
    {
      "key": "sortOrder",
      "label": "排序方式",
      "type": "select",
      "description": "笔记列表排序（置顶始终优先）",
      "defaultValue": "newest",
      "options": [
        { "value": "newest", "label": "最新创建" },
        { "value": "oldest", "label": "最早创建" },
        { "value": "updated", "label": "最近更新" }
      ]
    }
  ]
}
